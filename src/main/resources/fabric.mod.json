{
  "schemaVersion": 1,
  "id": "ragdollphysics",
  "version": "${version}",
  "name": "Ragdoll Physics",
  "description": "Adds a client-side articulated ragdoll simulation to the local player.",
  "authors": [
    "Andre Nicholas Jr"
  ],
  "license": "MIT",
  "environment": "*",
  "mixins": [
    {
      "config": "ragdollphysics.client.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "main": [
      "com.andre.ragdollphysics.RagdollPhysics"
    ],
    "client": [
      "com.andre.ragdollphysics.client.RagdollPhysicsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
